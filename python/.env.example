# コピーして .env にリネームし、値を入れる
LMS_BASE=https://lms.example.ac.jp
LMS_TOKEN=
DISCORD_WEBHOOK_URL=
# 何日先までの課題を通知するか
DAYS_AHEAD=7
# 名前にこれらを含む課題は除外する(カンマ区切り)
EXCLUDE_KEYWORDS=遅延提出者用

# --- Discord bot (!worklist) ---
# Discord Developer Portal で作ったbotのトークン(Webhook URLとは別物)
DISCORD_BOT_TOKEN=
# 応答を許可するユーザーID(カンマ区切り)。個人情報が出るため必須
DISCORD_ALLOWED_USER_IDS=
# 提出済みを何日前まで遡るか / 未提出を何日先まで出すか
WORKLIST_PAST_DAYS=14
WORKLIST_FUTURE_DAYS=30
